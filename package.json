{
  "name": "agentic-doc-governance-kit",
  "version": "0.1.2",
  "description": "A template and checker toolkit for AI-agent-readable documentation governance and autonomous feature delivery.",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "agentic-doc-governance": "bin/agentic-doc-governance.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/l02162010/agentic-doc-governance-kit.git"
  },
  "homepage": "https://github.com/l02162010/agentic-doc-governance-kit#readme",
  "bugs": {
    "url": "https://github.com/l02162010/agentic-doc-governance-kit/issues"
  },
  "files": [
    ".agentic-doc-governance.json",
    "AGENTS.template.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "RELEASE.md",
    "SECURITY.md",
    "bin",
    "examples",
    "scripts",
    "templates"
  ],
  "scripts": {
    "docs-check": "node scripts/docs-integrity-check.mjs --check-generated",
    "skills-check": "node scripts/skills-integrity-check.mjs",
    "closeout-check": "node scripts/agent-closeout-check.mjs --root examples/basic-product --feature FEAT-001",
    "metadata-check": "node scripts/package-metadata-check.mjs",
    "release-check": "npm test && node scripts/package-metadata-check.mjs --strict && npm pack --dry-run",
    "check": "node scripts/docs-integrity-check.mjs --check-generated && node scripts/skills-integrity-check.mjs && node scripts/agent-closeout-check.mjs --self-test && node scripts/agent-closeout-check.mjs --root examples/basic-product --feature FEAT-001",
    "test": "node --test && npm run check",
    "prepack": "npm test",
    "prepublishOnly": "node scripts/package-metadata-check.mjs --strict && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@10.9.8",
  "keywords": [
    "ai-agent",
    "documentation-governance",
    "agentic-workflow",
    "feature-lifecycle",
    "repo-template"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  }
}
